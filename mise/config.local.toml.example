# Local settings template. install.ps1 copies it to config.local.toml if that doesn't exist.
# config.local.toml is git-ignored - adjust the paths to the machine.
# mise is not activated in the PowerShell profile, so only `mise run` / `mise exec` see these variables.

[env]
# wsl:backup / wsl:restore tasks
WSL_BACKUP_DIR     = 'D:\backup\wsl'   # backups go to <dir>\<distro>\
WSL_BACKUP_DISTROS = 'Ubuntu'          # comma-separated, e.g. 'Ubuntu,Ubuntu-OpenRig'
WSL_BACKUP_KEEP    = '2'               # backups to keep per distro (latest + previous)
WSL_DISTRO_DIR     = 'C:\WSL'          # where restore installs a distro that doesn't exist: <dir>\<distro>
WSL_BACKUP_ZSTD    = '-3 --long'       # zstd compression options for wsl:backup (higher levels: slower, barely smaller)

# docker:backup / docker:restore tasks
DOCKER_BACKUP_DIR     = 'D:\backup\docker'   # backups go to <dir>\<volume>\
DOCKER_BACKUP_VOLUMES = '*'                  # comma-separated volume names, or '*' for all named volumes
DOCKER_BACKUP_KEEP    = '2'                  # backups to keep per volume
