# Szablon ustawien lokalnych. install.ps1 kopiuje go do config.local.toml, jesli ten nie istnieje.
# config.local.toml jest w .gitignore - dostosuj sciezki do komputera.
# mise nie jest aktywowany w profilu PowerShella, wiec te zmienne widza tylko `mise run` / `mise exec`.

[env]
# Taski wsl:backup / wsl:restore
WSL_BACKUP_DIR     = 'D:\backup\wsl'   # kopie trafiaja do <katalog>\<dystrybucja>\
WSL_BACKUP_DISTROS = 'Ubuntu'          # lista po przecinku, np. 'Ubuntu,Ubuntu-OpenRig'
WSL_BACKUP_KEEP    = '2'               # ile kopii trzymac na dystrybucje (aktualna + poprzednie)
WSL_DISTRO_DIR     = 'C:\WSL'          # gdzie restore instaluje dystrybucje, ktorej nie ma: <katalog>\<dystrybucja>
